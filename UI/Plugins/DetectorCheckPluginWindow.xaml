<Window x:Class="SEE_INSADE.UI.Plugins.DetectorCheckPluginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detector Check Plugin"
        Width="1180"
        Height="520"
        Background="#F5F7FA"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#172033"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#667085"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="LineBrush" Color="#D8DEE8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#1677FF"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Detector Check" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Live horizontal detector line" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="1,3,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#EAF2FF" BorderBrush="#C7DDFF" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,8,0">
                    <TextBlock x:Name="ActiveText" Text="Active: 0/0" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                </Border>
                <Border Background="#EEF8F1" BorderBrush="#C8EBD3" BorderThickness="1" CornerRadius="6" Padding="12,8">
                    <TextBlock x:Name="AverageText" Text="Signal: 0.000" FontWeight="SemiBold" Foreground="#208A43"/>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Viewbox Stretch="Fill">
                    <Image x:Name="DetectorLineImage"
                           Width="1000"
                           Height="260"
                           Stretch="Fill"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           MouseMove="DetectorLineImage_MouseMove"/>
                </Viewbox>

                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Low sensitivity / weak signal" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Grid.Column="1" Text="Detector pixels, left to right" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Grid.Column="2" Text="High sensitivity / strong signal" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectedText" Text="Move the cursor over the line to inspect a detector" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Close" Width="96" Height="36" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
