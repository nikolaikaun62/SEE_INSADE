<Window x:Class="SEE_INSADE.UI.Plugins.DetectorCheckPluginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SEE INSADE - Detector Check Plugin"
        Width="1180"
        Height="680"
        WindowStartupLocation="CenterOwner"
        Background="#070B10"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="PageBrush" Color="#070B10"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#0F1721"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#172231"/>
        <SolidColorBrush x:Key="LineBrush" Color="#28364A"/>
        <SolidColorBrush x:Key="TextBrush" Color="#EAF0F8"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8F9CAF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#37D3B5"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style x:Key="TinyLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#182230"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#2D3A4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Detector Check" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Detector line monitor + diagnostic visualization" Style="{StaticResource TinyLabel}" Margin="1,3,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#10251F" BorderBrush="#245A4D" BorderThickness="1" CornerRadius="7" Padding="12,8" Margin="0,0,8,0">
                    <TextBlock x:Name="ActiveText" Text="Active: 0/0" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                </Border>
                <Border Background="#111A27" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="12,8">
                    <TextBlock x:Name="AverageText" Text="Signal: 0.000" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="VISUALIZATION MODE" Style="{StaticResource TinyLabel}" Margin="0,0,0,8"/>
                        <RadioButton x:Name="ModeOverview" Content="Overview" Foreground="{StaticResource TextBrush}" IsChecked="True" Checked="VisualizationMode_Changed"/>
                        <RadioButton x:Name="ModeHealth" Content="Health Map" Foreground="{StaticResource TextBrush}" Margin="0,6,0,0" Checked="VisualizationMode_Changed"/>
                        <RadioButton x:Name="ModeActivity" Content="Activity" Foreground="{StaticResource TextBrush}" Margin="0,6,0,0" Checked="VisualizationMode_Changed"/>
                        <RadioButton x:Name="ModeSensitivity" Content="Sensitivity" Foreground="{StaticResource TextBrush}" Margin="0,6,0,0" Checked="VisualizationMode_Changed"/>

                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,16"/>

                        <TextBlock Text="DISPLAY OPTIONS" Style="{StaticResource TinyLabel}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ShowGrid" Content="Show Grid" Foreground="{StaticResource TextBrush}" IsChecked="True" Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed"/>
                        <CheckBox x:Name="ShowReadings" Content="Show Readings" Foreground="{StaticResource TextBrush}" IsChecked="True" Margin="0,6,0,0" Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed"/>
                        <CheckBox x:Name="AnimateScan" Content="Live Update" Foreground="{StaticResource TextBrush}" IsChecked="True" Margin="0,6,0,0" Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed"/>

                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,16"/>

                        <TextBlock Text="DETECTOR CONTROLS" Style="{StaticResource TinyLabel}" Margin="0,0,0,8"/>
                        <Button Content="TEST ALL DETECTORS" Style="{StaticResource ModernButton}" Click="TestAllDetectors_Click"/>
                        <Button Content="CALIBRATE SELECTED" Style="{StaticResource ModernButton}" Click="CalibrateSelected_Click"/>
                        <Button Content="GENERATE REPORT" Style="{StaticResource ModernButton}" Click="GenerateReport_Click"/>

                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,16"/>

                        <TextBlock Text="SELECTED DETECTOR" Style="{StaticResource TinyLabel}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="SelectedDetectorId" Text="ID: None" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                        <TextBlock x:Name="SelectedDetectorHealth" Text="Health: --" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0"/>
                        <TextBlock x:Name="SelectedDetectorSensitivity" Text="Sensitivity: --" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0"/>
                        <TextBlock x:Name="SelectedDetectorReading" Text="Reading: --" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0"/>
                        <TextBlock x:Name="SelectedDetectorDualEnergy" Text="Low/High: --" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0"/>
                        <TextBlock x:Name="SelectedDetectorMaterial" Text="Material: --" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Background="#05080C">
                <Grid>
                    <Viewbox Stretch="Uniform">
                        <Image x:Name="DetectorVisualizationImage"
                               Width="1000"
                               Height="460"
                               Stretch="None"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               MouseMove="DetectorImage_MouseMove"
                               MouseLeftButtonDown="DetectorImage_MouseLeftButtonDown"/>
                    </Viewbox>

                    <Border Background="#AA05080C"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="12"
                            Padding="12"
                            Width="250">
                        <StackPanel>
                            <TextBlock Text="DETECTOR ARRAY STATUS" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock x:Name="TotalDetectorsText" Text="Total: 400" FontSize="12"/>
                            <TextBlock x:Name="ActiveDetectorsText" Text="Active: 400" Foreground="#FF10B981" FontSize="12" Margin="0,3,0,0"/>
                            <TextBlock x:Name="HealthStatusText" Text="Avg Health: 95%" FontSize="12" Margin="0,3,0,0"/>
                            <TextBlock x:Name="ScanStatusText" Text="Scan: Ready" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <StatusBar Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,12,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready for detector diagnostics"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Visualization:" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="VisualizationModeText" Text="Overview" FontWeight="SemiBold"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
