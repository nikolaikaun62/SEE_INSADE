<Window x:Class="SEE_INSADE.UI.Plugins.NuctechImgPluginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SEE INSADE - Nuctech IMG Viewer"
        Width="1320"
        Height="780"
        WindowStartupLocation="CenterOwner"
        Background="#070B10"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#0F1721"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#172231"/>
        <SolidColorBrush x:Key="LineBrush" Color="#28364A"/>
        <SolidColorBrush x:Key="TextBrush" Color="#EAF0F8"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8F9CAF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#37D3B5"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style x:Key="TinyLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#182230"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#2D3A4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>

        <Style x:Key="FilterButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="MinHeight" Value="31"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Nuctech IMG Viewer" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Open real Nuctech .img scans and apply SEE INSADE filters" Style="{StaticResource TinyLabel}" Margin="1,3,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Open IMG" Style="{StaticResource ModernButton}" Click="OpenImg_Click"/>
                <Button Content="Reload" Style="{StaticResource ModernButton}" Click="Reload_Click"/>
                <Button Content="Export PNG" Style="{StaticResource ModernButton}" Click="ExportPng_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <WrapPanel x:Name="FilterButtonsPanel" Grid.Row="0">
                    <Button Content="Enhanced" Tag="EnhancedColor" Style="{StaticResource FilterButton}" Click="FilterButton_Click"/>
                    <Button Content="High Penetration" Tag="HighPenetration" Style="{StaticResource FilterButton}" Click="FilterButton_Click"/>
                    <Button Content="Organic" Tag="OrganicFocus" Style="{StaticResource FilterButton}" Click="FilterButton_Click"/>
                    <Button Content="Inorganic" Tag="InorganicFocus" Style="{StaticResource FilterButton}" Click="FilterButton_Click"/>
                    <Button Content="Metal" Tag="MetalFocus" Style="{StaticResource FilterButton}" Click="FilterButton_Click"/>
                    <Button Content="Density Map" Tag="DensityMap" Style="{StaticResource FilterButton}" Click="FilterButton_Click"/>
                    <Button Content="Negative" Tag="Negative" Style="{StaticResource FilterButton}" Click="FilterButton_Click"/>
                    <Button Content="Threshold" Tag="Threshold" Style="{StaticResource FilterButton}" Click="FilterButton_Click"/>
                    <Button Content="Edge" Tag="EdgeEmphasis" Style="{StaticResource FilterButton}" Click="FilterButton_Click"/>
                    <Button Content="Suspect" Tag="SuspectHighlight" Style="{StaticResource FilterButton}" Click="FilterButton_Click"/>
                </WrapPanel>

                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Filter strength" Style="{StaticResource TinyLabel}"/>
                        <Slider x:Name="FilterStrengthSlider" Minimum="0.1" Maximum="3.0" Value="1.0" ValueChanged="FilterSettings_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <CheckBox x:Name="BrightnessCheck" Content="Brightness" Checked="FilterSettings_Changed" Unchecked="FilterSettings_Changed"/>
                        <Slider x:Name="BrightnessSlider" Minimum="0.1" Maximum="3.0" Value="1.0" ValueChanged="FilterSettings_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,16,0">
                        <CheckBox x:Name="ContrastCheck" Content="Contrast" Checked="FilterSettings_Changed" Unchecked="FilterSettings_Changed"/>
                        <Slider x:Name="ContrastSlider" Minimum="0.1" Maximum="3.0" Value="1.0" ValueChanged="FilterSettings_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="0,0,16,0">
                        <CheckBox x:Name="MaterialCheck" Content="Material enhancement" Checked="FilterSettings_Changed" Unchecked="FilterSettings_Changed"/>
                        <CheckBox x:Name="EdgeCheck" Content="Edge detection" Checked="FilterSettings_Changed" Unchecked="FilterSettings_Changed"/>
                        <CheckBox x:Name="NoiseCheck" Content="Noise reduction" Checked="FilterSettings_Changed" Unchecked="FilterSettings_Changed"/>
                    </StackPanel>

                    <WrapPanel Grid.Column="4" VerticalAlignment="Center">
                        <TextBlock Text="Height" Style="{StaticResource TinyLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="HeightTextBox" Text="Auto" Width="64" Height="30" Margin="0,0,10,0"/>
                        <TextBlock Text="Offset" Style="{StaticResource TinyLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="OffsetTextBox" Text="Auto" Width="72" Height="30" Margin="0,0,10,0"/>
                        <CheckBox x:Name="RotateCheck" Content="Rotate 90°" IsChecked="False" Checked="DecodeSettings_Changed" Unchecked="DecodeSettings_Changed" Margin="0,0,10,0"/>
                        <CheckBox x:Name="FlipXCheck" Content="Flip X" Checked="DecodeSettings_Changed" Unchecked="DecodeSettings_Changed" Margin="0,0,10,0"/>
                        <CheckBox x:Name="FlipYCheck" Content="Flip Y" Checked="DecodeSettings_Changed" Unchecked="DecodeSettings_Changed"/>
                    </WrapPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Background="#030507" Padding="12">
            <Grid Background="#020304">
                <Viewbox Stretch="Uniform">
                    <Image x:Name="PreviewImage" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Viewbox>

                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="#CC030507"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Margin="12"
                        Padding="10">
                    <StackPanel>
                        <TextBlock x:Name="FileText" Text="No file loaded" FontWeight="Bold"/>
                        <TextBlock x:Name="MetaText" Text="Open a .img file" Style="{StaticResource TinyLabel}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <StatusBar Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
