<Window x:Class="SEE_INSADE.UI.Plugins.ConfigurationPluginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SEE INSADE - Configuration Plugin"
        Width="1180"
        Height="760"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7FB"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="LineBrush" Color="#D9E2EF"/>
        <SolidColorBrush x:Key="InkBrush" Color="#172033"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#667085"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#0F766E"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Configuration" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="Deep scanner, filter, plugin and user-access settings" Foreground="{StaticResource MutedBrush}" Margin="1,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#E7F7F4" BorderBrush="#BEE5DC" BorderThickness="1" CornerRadius="6" Padding="12,8" VerticalAlignment="Center">
                <TextBlock x:Name="CurrentUserText" Text="Current user: Administrator" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
            <TabControl>
                <TabItem Header="Scanner">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <UniformGrid Columns="2" Margin="8">
                            <StackPanel Margin="0,0,18,0">
                                <TextBlock Text="Scan width" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="WidthTextBox" Style="{StaticResource FieldBox}"/>
                                <TextBlock Text="Scan height" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="HeightTextBox" Style="{StaticResource FieldBox}"/>
                                <TextBlock Text="Detector count" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="DetectorCountTextBox" Style="{StaticResource FieldBox}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Conveyor speed" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="SpeedTextBox" Style="{StaticResource FieldBox}"/>
                                <TextBlock Text="Detector sensitivity" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="DetectorSensitivityTextBox" Style="{StaticResource FieldBox}"/>
                                <CheckBox x:Name="AutoStartCheckBox" Content="Auto-start scanning"/>
                            </StackPanel>
                        </UniformGrid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Display">
                    <UniformGrid Columns="2" Margin="8">
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="Brightness" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="BrightnessTextBox" Style="{StaticResource FieldBox}"/>
                            <TextBlock Text="Contrast" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="ContrastTextBox" Style="{StaticResource FieldBox}"/>
                            <TextBlock Text="Color scheme" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="ColorSchemeTextBox" Style="{StaticResource FieldBox}"/>
                        </StackPanel>
                        <StackPanel>
                            <CheckBox x:Name="ShowGridCheckBox" Content="Show grid"/>
                            <CheckBox x:Name="ShowDetectorInfoCheckBox" Content="Show detector info" Margin="0,8,0,0"/>
                        </StackPanel>
                    </UniformGrid>
                </TabItem>

                <TabItem Header="Filters">
                    <StackPanel Margin="8">
                        <TextBlock Text="Active preset" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="ActivePresetTextBox" Style="{StaticResource FieldBox}"/>
                        <TextBlock Text="Filter configuration is persisted in Config/settings.json and applied by the main scanner UI." Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Plugins">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="External plugin DLL files are loaded from the Plugins folder next to the application executable." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
                        <ListBox x:Name="PluginListBox" Grid.Row="1"/>
                    </Grid>
                </TabItem>

                <TabItem Header="Users and access">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="320"/>
                        </Grid.ColumnDefinitions>

                        <DataGrid x:Name="UsersGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionChanged="UsersGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="*"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*"/>
                                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="110"/>
                                <DataGridTextColumn Header="Level" Binding="{Binding AccessLevel}" Width="80"/>
                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="User name" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="UserNameTextBox" Style="{StaticResource FieldBox}"/>
                            <TextBlock Text="Display name" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="DisplayNameTextBox" Style="{StaticResource FieldBox}"/>
                            <TextBlock Text="Role" Style="{StaticResource LabelText}"/>
                            <ComboBox x:Name="RoleComboBox" MinHeight="34" Margin="0,0,0,12"/>
                            <TextBlock Text="Access level" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="AccessLevelTextBox" Style="{StaticResource FieldBox}"/>
                            <TextBlock Text="New password" Style="{StaticResource LabelText}"/>
                            <PasswordBox x:Name="PasswordBox" MinHeight="34" Margin="0,0,0,12"/>
                            <CheckBox x:Name="UserActiveCheckBox" Content="Active user"/>
                            <WrapPanel Margin="0,14,0,0">
                                <Button Content="Add" Style="{StaticResource ActionButton}" Click="AddUser_Click"/>
                                <Button Content="Update" Style="{StaticResource ActionButton}" Click="UpdateUser_Click"/>
                                <Button Content="Remove" Style="{StaticResource ActionButton}" Click="RemoveUser_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,18,0"/>
            <Button Content="Reload" Style="{StaticResource ActionButton}" Click="Reload_Click"/>
            <Button Content="Save" Style="{StaticResource ActionButton}" Click="Save_Click"/>
            <Button Content="Close" Style="{StaticResource ActionButton}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
