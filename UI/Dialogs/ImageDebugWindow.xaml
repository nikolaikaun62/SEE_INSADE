<Window x:Class="SEE_INSADE.UI.Dialogs.ImageDebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SEE INSADE - Image Debug Tools" 
        Height="700" Width="1000"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="4" Padding="15,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔍" FontSize="20" Margin="0,0,10,0"/>
                <TextBlock Text="IMAGE DEBUG &amp; ANALYSIS TOOLS" 
                          FontSize="16" FontWeight="Bold" Foreground="White"/>
            </StackPanel>
        </Border>

        <!-- Debug Content -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Tools Panel -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="4" Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">

                        <!-- Analysis Tools -->
                        <GroupBox Header="Analysis Tools" Foreground="White" Background="#FF1A1A2E" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <Button Content="📊 PIXEL ANALYZER" Style="{StaticResource ModernButton}" 
                                       Click="PixelAnalyzer_Click"/>
                                <Button Content="📈 HISTOGRAM" Style="{StaticResource ModernButton}" 
                                       Margin="0,5,0,0" Click="Histogram_Click"/>
                                <Button Content="🎯 MATERIAL MAP" Style="{StaticResource ModernButton}" 
                                       Margin="0,5,0,0" Click="MaterialMap_Click"/>
                                <Button Content="🔥 HEAT MAP" Style="{StaticResource ModernButton}" 
                                       Margin="0,5,0,0" Click="HeatMap_Click"/>
                                <Button Content="🔍 EDGE DETECTION" Style="{StaticResource ModernButton}" 
                                       Margin="0,5,0,0" Click="EdgeDetection_Click"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Measurement Tools -->
                        <GroupBox Header="Measurement Tools" Foreground="White" Background="#FF1A1A2E" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <Button Content="📏 DISTANCE TOOL" Style="{StaticResource ModernButton}" 
                                       Click="DistanceTool_Click"/>
                                <Button Content="⚖️ DENSITY PROFILE" Style="{StaticResource ModernButton}" 
                                       Margin="0,5,0,0" Click="DensityProfile_Click"/>
                                <Button Content="📐 ANGLE MEASURE" Style="{StaticResource ModernButton}" 
                                       Margin="0,5,0,0" Click="AngleMeasure_Click"/>
                                <Button Content="🔢 OBJECT COUNTER" Style="{StaticResource ModernButton}" 
                                       Margin="0,5,0,0" Click="ObjectCounter_Click"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Enhancement Tools -->
                        <GroupBox Header="Enhancement Tools" Foreground="White" Background="#FF1A1A2E" Padding="10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="Brightness:" Foreground="#FF94A3B8" Width="80"/>
                                    <Slider x:Name="DebugBrightnessSlider" Minimum="0.1" Maximum="3.0" Value="1.0" Width="80"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="Contrast:" Foreground="#FF94A3B8" Width="80"/>
                                    <Slider x:Name="DebugContrastSlider" Minimum="0.1" Maximum="3.0" Value="1.0" Width="80"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="Gamma:" Foreground="#FF94A3B8" Width="80"/>
                                    <Slider x:Name="DebugGammaSlider" Minimum="0.5" Maximum="2.5" Value="1.0" Width="80"/>
                                </StackPanel>
                                <Button Content="APPLY ENHANCEMENT" Style="{StaticResource ModernButton}" 
                                       Margin="0,10,0,0" Click="ApplyEnhancement_Click"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Info Panel -->
                        <Border Background="#202563EB" CornerRadius="4" Padding="10" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Pixel Info:" Foreground="#FF60A5FA" FontWeight="SemiBold"/>
                                <TextBlock x:Name="PixelInfoText" Text="Hover over image" 
                                          Foreground="#FF94A3B8" FontSize="10" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Image Display -->
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="4">
                <Grid>
                    <Viewbox Stretch="Uniform">
                        <Image x:Name="DebugImage" Stretch="None" 
                               RenderOptions.BitmapScalingMode="HighQuality"
                               MouseMove="DebugImage_MouseMove"
                               MouseLeftButtonDown="DebugImage_MouseLeftButtonDown"/>
                    </Viewbox>

                    <!-- Overlay Canvas for tools -->
                    <Canvas x:Name="DebugOverlayCanvas" Background="Transparent"/>

                    <!-- Measurement Info -->
                    <Border x:Name="MeasurementInfoPanel" Background="#80000000" CornerRadius="4" 
                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Padding="10"
                           Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="MeasurementText" Text="" Foreground="White" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="{StaticResource PanelBrush}" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock x:Name="DebugStatusText" Text="Ready for analysis" Foreground="White"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Zoom:" Foreground="#FF94A3B8" Margin="0,0,10,0"/>
                    <Slider x:Name="ZoomSlider" Minimum="0.5" Maximum="3.0" Value="1.0" Width="100"/>
                    <TextBlock x:Name="ZoomText" Text="100%" Width="40" Margin="10,0,0,0" Foreground="White"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>