<Window x:Class="SEE_INSADE.UI.Dialogs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SEE INSADE - Basic Settings"
        Height="620"
        Width="780"
        WindowStartupLocation="CenterOwner"
        Background="#070B10"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#0F1721"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#172231"/>
        <SolidColorBrush x:Key="LineBrush" Color="#28364A"/>
        <SolidColorBrush x:Key="TextBrush" Color="#EAF0F8"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8F9CAF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#37D3B5"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style x:Key="TinyLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#182230"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#2D3A4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Basic Program Settings" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Default scan, direction and filter parameters for the current session" Style="{StaticResource TinyLabel}" Margin="1,4,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="SCAN PARAMETERS" Style="{StaticResource TinyLabel}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Default speed" VerticalAlignment="Center"/>
                            <Slider x:Name="DefaultSpeedSlider" Grid.Column="1" Minimum="0.1" Maximum="3.0" Value="1.0" ValueChanged="Slider_ValueChanged"/>
                            <TextBlock x:Name="DefaultSpeedValueText" Grid.Column="2" Text="1.0x" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Detector sensitivity" VerticalAlignment="Center"/>
                            <Slider x:Name="DefaultSensitivitySlider" Grid.Column="1" Minimum="0.1" Maximum="2.0" Value="1.0" ValueChanged="Slider_ValueChanged"/>
                            <TextBlock x:Name="DefaultSensitivityValueText" Grid.Column="2" Text="100%" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                        </Grid>

                        <CheckBox x:Name="InvertDirectionCheck" Content="Invert scan direction by default"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="DEFAULT FILTER" Style="{StaticResource TinyLabel}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Filter mode" VerticalAlignment="Center"/>
                            <ComboBox x:Name="DefaultFilterComboBox" Grid.Column="1" MinHeight="34" Background="{StaticResource PanelAltBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Filter strength" VerticalAlignment="Center"/>
                            <Slider x:Name="FilterStrengthSlider" Grid.Column="1" Minimum="0.1" Maximum="3.0" Value="1.0" ValueChanged="Slider_ValueChanged"/>
                            <TextBlock x:Name="FilterStrengthValueText" Grid.Column="2" Text="1.0x" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="IMAGE ADJUSTMENT" Style="{StaticResource TinyLabel}" Margin="0,0,0,10"/>

                        <CheckBox x:Name="BrightnessEnableCheck" Content="Enable brightness correction"/>
                        <Slider x:Name="BrightnessSlider" Minimum="0.1" Maximum="3.0" Value="1.0" ValueChanged="Slider_ValueChanged"/>
                        <TextBlock x:Name="BrightnessValueText" Text="Brightness: 1.0x" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,8"/>

                        <CheckBox x:Name="ContrastEnableCheck" Content="Enable contrast correction"/>
                        <Slider x:Name="ContrastSlider" Minimum="0.1" Maximum="3.0" Value="1.0" ValueChanged="Slider_ValueChanged"/>
                        <TextBlock x:Name="ContrastValueText" Text="Contrast: 1.0x" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,8"/>

                        <CheckBox x:Name="MaterialEnhancementCheck" Content="Material enhancement"/>
                        <CheckBox x:Name="EdgeDetectionCheck" Content="Edge detection"/>
                        <CheckBox x:Name="NoiseReductionCheck" Content="Noise reduction"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Apply" Width="96" Style="{StaticResource ModernButton}" Click="Apply_Click"/>
            <Button Content="Save" Width="96" Style="{StaticResource ModernButton}" Click="Save_Click"/>
            <Button Content="Cancel" Width="96" Style="{StaticResource ModernButton}" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
