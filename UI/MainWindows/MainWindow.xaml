<Window x:Class="SEE_INSADE.UI.MainWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SEE INSADE - Professional Scanner" 
        Height="900" Width="1600"
        WindowState="Maximized"
        Background="#FF0F0F17">

    <Window.Resources>
        <Style x:Key="ControlGroupStyle" TargetType="GroupBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#FF1A1A2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FF2563EB"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF2563EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FF1A1A2E" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="🔍" FontSize="20" Margin="0,0,10,0"/>
                    <TextBlock Text="SEE INSADE" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="PROFESSIONAL SCANNER" FontSize="12" Foreground="#FF94A3B8" 
                              VerticalAlignment="Bottom" Margin="10,0,0,2"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Status:" Foreground="#FF94A3B8" Margin="0,0,10,0"/>
                    <TextBlock x:Name="StatusText" Text="READY" Foreground="#FF10B981" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="⚙️ SETTINGS" Style="{StaticResource ModernButton}" Click="OpenSettings_Click"/>
                    <Button Content="🔧 DIAGNOSTICS" Style="{StaticResource ModernButton}" Margin="10,0,0,0" Click="OpenDiagnostics_Click"/>
                    <Button Content="🎯 CALIBRATE" Style="{StaticResource ModernButton}" Margin="10,0,0,0" Click="OpenCalibration_Click"/>
                    <Button Content="📡 DETECTORS" Style="{StaticResource ModernButton}" Margin="10,0,0,0" Click="OpenDetectorVisualization_Click"/>
                
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- Scanning Area -->
            <Border Grid.Column="0" Background="#FF1A1A2E" Margin="10" CornerRadius="4">
                <Grid>
                    <TabControl x:Name="ViewTabControl" Background="Transparent" BorderThickness="0">

                        <!-- Standard View -->
                        <TabItem Header="STANDARD VIEW">
                            <Viewbox Stretch="Uniform">
                                <Image x:Name="ScanImage" Stretch="None"/>
                            </Viewbox>
                        </TabItem>

                        <!-- Material Analysis -->
                        <TabItem Header="MATERIAL ANALYSIS">
                            <Viewbox Stretch="Uniform">
                                <Image x:Name="MaterialImage" Stretch="None"/>
                            </Viewbox>
                        </TabItem>

                        <!-- Density Map -->
                        <TabItem Header="DENSITY MAP">
                            <Viewbox Stretch="Uniform">
                                <Image x:Name="DensityImage" Stretch="None"/>
                            </Viewbox>
                        </TabItem>

                        <!-- Filtered View -->
                        <TabItem Header="FILTERED VIEW">
                            <Viewbox Stretch="Uniform">
                                <Image x:Name="FilteredImage" Stretch="None"/>
                            </Viewbox>
                        </TabItem>

                    </TabControl>

                    <!-- Real-time Info Panel -->
                    <Border Background="#80000000" CornerRadius="4" 
                           HorizontalAlignment="Right" VerticalAlignment="Top" 
                           Margin="10" Padding="10" Width="250">
                        <StackPanel>
                            <TextBlock Text="SCAN INFO" Foreground="#FF60A5FA" 
                                      FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock x:Name="PositionText" Text="Position: 0px" Foreground="White" FontSize="11"/>
                            <TextBlock x:Name="ObjectsText" Text="Objects: 0" Foreground="White" FontSize="11"/>
                            <TextBlock x:Name="SpeedText" Text="Speed: 1.0x" Foreground="White" FontSize="11"/>
                            <TextBlock x:Name="DetectorsText" Text="Detectors: 400/400" Foreground="White" FontSize="11"/>
                            <TextBlock x:Name="MaterialsText" Text="Materials: 0 types" Foreground="White" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Control Panel -->
            <Border Grid.Column="1" Background="#FF1A1A2E" Margin="0,10,10,10" CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">

                        <!-- Scan Controls -->
                        <GroupBox Header="SCAN CONTROLS" Style="{StaticResource ControlGroupStyle}">
                            <StackPanel Margin="5">
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="Speed:" Foreground="White" Width="80" VerticalAlignment="Center"/>
                                    <Slider x:Name="SpeedSlider" Minimum="0.1" Maximum="3.0" Value="1.0" 
                                           Width="120" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SpeedValueText" Text="1.0x" Foreground="#FF60A5FA" 
                                              Width="30" Margin="5,0,0,0" FontWeight="Bold"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,10">
                                    <TextBlock Text="Sensitivity:" Foreground="White" Width="80" VerticalAlignment="Center"/>
                                    <Slider x:Name="SensitivitySlider" Minimum="0.1" Maximum="2.0" Value="1.0" 
                                           Width="120" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SensitivityValueText" Text="100%" Foreground="#FF60A5FA" 
                                              Width="30" Margin="5,0,0,0" FontWeight="Bold"/>
                                </StackPanel>

                                <UniformGrid Columns="3" Margin="0,10,0,0">
                                    <Button Content="▶ START" Style="{StaticResource ModernButton}" 
                                           Click="StartScan_Click"/>
                                    <Button Content="⏸ PAUSE" Style="{StaticResource ModernButton}" 
                                           Click="PauseScan_Click"/>
                                    <Button Content="⏹ STOP" Style="{StaticResource ModernButton}" 
                                           Click="StopScan_Click"/>
                                    <Button Content="🔄 RESET" Style="{StaticResource ModernButton}" 
                                           Click="ResetScan_Click"/>
                                    <Button Content="📷 SNAPSHOT" Style="{StaticResource ModernButton}" 
                                           Click="TakeSnapshot_Click"/>
                                    <Button Content="📊 ANALYZE" Style="{StaticResource ModernButton}" 
                                           Click="OpenAnalysis_Click"/>
                                </UniformGrid>
                            </StackPanel>
                        </GroupBox>

                        <!-- Filter Controls -->
                        <GroupBox Header="FILTERS" Style="{StaticResource ControlGroupStyle}">
                            <StackPanel Margin="5">
                                <CheckBox x:Name="BrightnessFilterCheck" Content="Brightness" Foreground="White" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                                <Slider x:Name="BrightnessSlider" Minimum="0.1" Maximum="3.0" Value="1.0" Margin="0,5" ValueChanged="Filter_Changed"/>

                                <CheckBox x:Name="ContrastFilterCheck" Content="Contrast" Foreground="White" Margin="0,10,0,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                                <Slider x:Name="ContrastSlider" Minimum="0.1" Maximum="3.0" Value="1.0" Margin="0,5" ValueChanged="Filter_Changed"/>

                                <CheckBox x:Name="MaterialFilterCheck" Content="Material Enhance" Foreground="White" Margin="0,10,0,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                                <CheckBox x:Name="EdgeFilterCheck" Content="Edge Detection" Foreground="White" Margin="0,5,0,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                                <CheckBox x:Name="NoiseFilterCheck" Content="Noise Reduction" Foreground="White" Margin="0,5,0,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>

                                <Button Content="APPLY FILTERS" Style="{StaticResource ModernButton}" 
                                       Margin="0,10,0,0" Click="ApplyFilters_Click"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Detector Status -->
                        <GroupBox Header="DETECTOR STATUS" Style="{StaticResource ControlGroupStyle}">
                            <StackPanel Margin="5">
                                <ProgressBar x:Name="DetectorHealthBar" Value="95" Maximum="100" Height="10" Margin="0,5"/>
                                <TextBlock x:Name="DetectorHealthText" Text="Health: 95%" Foreground="#FF10B981" FontSize="10"/>
                                <Button Content="TEST DETECTORS" Style="{StaticResource ModernButton}" 
                                       Margin="0,10,0,0" Click="TestDetectors_Click"/>
                                <Button Content="CALIBRATE" Style="{StaticResource ModernButton}" 
                                       Margin="0,5,0,0" Click="CalibrateDetectors_Click"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- System Info -->
                        <Border Background="#FF0F0F17" CornerRadius="4" Margin="0,10,0,0" Padding="10">
                            <StackPanel>
                                <TextBlock Text="SYSTEM INFO" Foreground="#FF60A5FA" FontWeight="Bold" 
                                          Margin="0,0,0,5"/>
                                <TextBlock x:Name="FrameRateText" Text="FPS: 0" Foreground="White" FontSize="10"/>
                                <TextBlock x:Name="MemoryText" Text="Memory: 0 MB" Foreground="White" FontSize="10"/>
                                <TextBlock x:Name="ProcessingText" Text="Processing: Idle" Foreground="White" FontSize="10"/>
                                <TextBlock x:Name="FilterCountText" Text="Active Filters: 0" Foreground="White" FontSize="10"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="#FF1A1A2E">
            <StatusBarItem>
                <TextBlock x:Name="MainStatusText" Text="SEE INSADE - Ready for scanning" 
                          Foreground="White" FontWeight="SemiBold"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="TimeText" Text="00:00:00" Foreground="#FF94A3B8" Margin="10,0,0,0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>