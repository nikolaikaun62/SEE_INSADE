<Window x:Class="SEE_INSADE.UI.MainWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SEE INSADE - Professional Scanner"
        Height="900"
        Width="1600"
        WindowState="Maximized"
        Background="#070B10"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="PageBrush" Color="#070B10"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#0F1721"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#172231"/>
        <SolidColorBrush x:Key="LineBrush" Color="#28364A"/>
        <SolidColorBrush x:Key="TextBrush" Color="#EAF0F8"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8F9CAF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#37D3B5"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#EF6F6C"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style x:Key="TinyLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="CompactPanel" TargetType="Border">
            <Setter Property="Background" Value="#0B1119"/>
            <Setter Property="BorderBrush" Value="#223047"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="9"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="ControlGroupStyle" TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <StackPanel>
                            <TextBlock Text="{TemplateBinding Header}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,0,0,10"/>
                            <ContentPresenter/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#182230"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#2D3A4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#223047"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#37D3B5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#0F766E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#0F766E"/>
            <Setter Property="BorderBrush" Value="#37D3B5"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#432027"/>
            <Setter Property="BorderBrush" Value="#7A3142"/>
        </Style>

        <Style x:Key="FilterTabButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="MinHeight" Value="31"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="Margin" Value="3,0,3,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="#182230"/>
            <Setter Property="BorderBrush" Value="#2D3A4D"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0B1119"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#2D3A4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="30"/>
        </Style>
    </Window.Resources>

        <Grid Background="{StaticResource PageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0B1118" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="SEE INSADE" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="SubtitleText" Text="X-RAY LINE SCAN EMULATOR" Style="{StaticResource TinyLabel}" Margin="1,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#10251F" BorderBrush="#245A4D" BorderThickness="1" CornerRadius="8" Padding="13,7">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="StatusText" Text="READY" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="LanguageLabel" Text="Language" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold"/>
                    <ComboBox x:Name="LanguageComboBox" Width="118" MinHeight="36" Margin="0,0,12,0" SelectionChanged="LanguageComboBox_SelectionChanged"/>

                    <TextBlock Text="Plugin" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold"/>
                    <ComboBox x:Name="PluginComboBox"
                              Width="190"
                              MinHeight="36"
                              Margin="0,0,6,0"
                              Background="{StaticResource PanelAltBrush}"
                              Foreground="{StaticResource TextBrush}"
                              BorderBrush="{StaticResource LineBrush}"/>
                    <Button x:Name="OpenPluginButton" Content="Open Plugin" Style="{StaticResource ModernButton}" Margin="0,0,12,0" Click="LaunchPlugin_Click"/>

                    <Button x:Name="SettingsButton" Content="Settings" Style="{StaticResource ModernButton}" Click="OpenSettings_Click"/>
                    <Button x:Name="DiagnosticsButton" Content="Diagnostics" Style="{StaticResource ModernButton}" Click="OpenDiagnostics_Click" Visibility="Collapsed"/>
                    <Button x:Name="CalibrateButton" Content="Calibrate" Style="{StaticResource ModernButton}" Click="OpenCalibration_Click"/>
                    <Button x:Name="DetectorsButton" Content="Detectors" Style="{StaticResource ModernButton}" Click="OpenDetectorVisualization_Click" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="92"/>
            </Grid.RowDefinitions>

            <!-- Filters and tuning controls -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="8" Margin="0,0,0,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="0"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="FilterTabsPanel" Orientation="Horizontal">
                            <Button x:Name="EnhancedColorTabButton" Content="Enhanced" Tag="EnhancedColor" Style="{StaticResource FilterTabButton}" Click="FilterTab_Click"/>
                            <Button x:Name="HighPenetrationTabButton" Content="High Penetration" Tag="HighPenetration" Style="{StaticResource FilterTabButton}" Click="FilterTab_Click"/>
                            <Button x:Name="OrganicFocusTabButton" Content="Organic" Tag="OrganicFocus" Style="{StaticResource FilterTabButton}" Click="FilterTab_Click"/>
                            <Button x:Name="InorganicFocusTabButton" Content="Inorganic" Tag="InorganicFocus" Style="{StaticResource FilterTabButton}" Click="FilterTab_Click"/>
                            <Button x:Name="MetalFocusTabButton" Content="Metal" Tag="MetalFocus" Style="{StaticResource FilterTabButton}" Click="FilterTab_Click"/>
                            <Button x:Name="DensityMapTabButton" Content="Density Map" Tag="DensityMap" Style="{StaticResource FilterTabButton}" Click="FilterTab_Click"/>
                            <Button x:Name="NegativeTabButton" Content="Negative" Tag="Negative" Style="{StaticResource FilterTabButton}" Click="FilterTab_Click"/>
                            <Button x:Name="ThresholdTabButton" Content="Threshold" Tag="Threshold" Style="{StaticResource FilterTabButton}" Click="FilterTab_Click"/>
                            <Button x:Name="EdgeEmphasisTabButton" Content="Edge" Tag="EdgeEmphasis" Style="{StaticResource FilterTabButton}" Click="FilterTab_Click"/>
                            <Button x:Name="SuspectHighlightTabButton" Content="Suspect" Tag="SuspectHighlight" Style="{StaticResource FilterTabButton}" Click="FilterTab_Click"/>
                        </WrapPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="1" Margin="0,4,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CompactPanel}">
                            <StackPanel>
                                <TextBlock x:Name="FilterStrengthLabel" Text="Filter strength" Style="{StaticResource TinyLabel}"/>
                                <Slider x:Name="OperatorFilterSlider" Minimum="0.1" Maximum="3.0" Value="1.0" ValueChanged="OperatorFilter_Changed"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CompactPanel}">
                            <StackPanel>
                                <CheckBox x:Name="BrightnessFilterCheck" Content="Brightness" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                                <Slider x:Name="BrightnessSlider" Minimum="0.1" Maximum="3.0" Value="1.0" ValueChanged="Filter_Changed"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CompactPanel}">
                            <StackPanel>
                                <CheckBox x:Name="ContrastFilterCheck" Content="Contrast" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                                <Slider x:Name="ContrastSlider" Minimum="0.1" Maximum="3.0" Value="1.0" ValueChanged="Filter_Changed"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Style="{StaticResource CompactPanel}">
                            <WrapPanel VerticalAlignment="Center">
                                <CheckBox x:Name="MaterialFilterCheck" Content="Material enhancement" Checked="Filter_Changed" Unchecked="Filter_Changed" Margin="0,0,14,0"/>
                                <CheckBox x:Name="EdgeFilterCheck" Content="Edge detection" Checked="Filter_Changed" Unchecked="Filter_Changed" Margin="0,0,14,0"/>
                                <CheckBox x:Name="NoiseFilterCheck" Content="Noise reduction" Checked="Filter_Changed" Unchecked="Filter_Changed" Margin="0,0,0,0"/>
                            </WrapPanel>
                        </Border>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="TestArrayButton" Content="Test Array" Style="{StaticResource ModernButton}" Click="TestDetectors_Click"/>
                            <Button x:Name="CalibrateDetectorsButton" Content="Calibrate" Style="{StaticResource ModernButton}" Click="CalibrateDetectors_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Full-height scanning screen -->
            <Border Grid.Row="1"
                    Style="{StaticResource CardBorder}"
                    Background="#030507"
                    Padding="6"
                    ClipToBounds="True">
                <Grid x:Name="ProjectionHost"
                      Background="#020304"
                      ClipToBounds="True"
                      Cursor="Cross"
                      MouseWheel="ProjectionHost_MouseWheel"
                      MouseLeftButtonDown="ProjectionHost_MouseLeftButtonDown"
                      MouseLeftButtonUp="ProjectionHost_MouseLeftButtonUp"
                      MouseMove="ProjectionHost_MouseMove"
                      MouseRightButtonDown="ProjectionHost_MouseRightButtonDown">
                    <Image x:Name="FilteredImage"
                           Stretch="None"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ProjectionScaleTransform" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="ProjectionTranslateTransform" X="0" Y="0"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                    <Border x:Name="ScanLineIndicator"
                            HorizontalAlignment="Right"
                            Width="1"
                            Background="{StaticResource AccentBrush}"
                            Opacity="0.55"
                            IsHitTestVisible="False"
                            Visibility="Collapsed"/>
                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="10"
                            Background="#D00B1118"
                            BorderBrush="#2D3A4D"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="9,5"
                            IsHitTestVisible="False">
                        <TextBlock x:Name="ZoomText" Text="100%" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="10"
                                Orientation="Horizontal">
                        <Button x:Name="FitWidthButton"
                                Content="Width"
                                Style="{StaticResource ModernButton}"
                                MinHeight="28"
                                Padding="9,4"
                                Margin="0,0,6,0"
                                Click="FitWidth_Click"/>
                        <Button x:Name="FitScreenButton"
                                Content="Fit"
                                Style="{StaticResource ModernButton}"
                                MinHeight="28"
                                Padding="9,4"
                                Margin="0"
                                Click="FitScreen_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Horizontal scan control panel -->
            <Border Grid.Row="2"
                    Style="{StaticResource CardBorder}"
                    Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock x:Name="ConveyorSpeedLabel" Text="Conveyor speed" Style="{StaticResource TinyLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="54"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SpeedSlider" Minimum="0.1" Maximum="3.0" Value="1.0"/>
                            <TextBlock x:Name="SpeedValueText" Grid.Column="1" Text="1.0x" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock x:Name="DetectorSensitivityLabel" Text="Detector sensitivity" Style="{StaticResource TinyLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="54"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SensitivitySlider" Minimum="0.1" Maximum="2.0" Value="1.0"/>
                            <TextBlock x:Name="SensitivityValueText" Grid.Column="1" Text="100%" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock x:Name="ScanSettingsLabel" Text="SCAN SETTINGS" Style="{StaticResource TinyLabel}"/>
                        <ComboBox x:Name="ScanSourceComboBox"
                                  MinHeight="30"
                                  Margin="0,5,0,0"
                                  SelectionChanged="ScanSourceComboBox_SelectionChanged"/>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ArchiveFolderTextBox"
                                     IsReadOnly="True"
                                     ToolTip="IMG archive folder"/>
                            <Button x:Name="BrowseArchiveFolderButton"
                                    Grid.Column="1"
                                    Content="..."
                                    Width="42"
                                    MinHeight="30"
                                    Padding="0"
                                    Margin="6,0,0,0"
                                    Style="{StaticResource ModernButton}"
                                    Click="BrowseArchiveFolder_Click"/>
                        </Grid>
                        <CheckBox x:Name="InvertDirectionCheck" Content="Invert scan direction" Margin="0,4,0,0"/>
                    </StackPanel>

                    <UniformGrid Grid.Column="3" Columns="6" VerticalAlignment="Center">
                        <Button x:Name="ForwardScanButton" Content="▶ Forward" Style="{StaticResource PrimaryButton}" Click="ForwardScan_Click"/>
                        <Button x:Name="StopButton" Content="■ Stop" Style="{StaticResource DangerButton}" Click="StopScan_Click"/>
                        <Button x:Name="BackwardScanButton" Content="◀ Backward" Style="{StaticResource ModernButton}" Click="BackwardScan_Click"/>
                        <Button x:Name="ResetButton" Content="Reset" Style="{StaticResource ModernButton}" Click="ResetScan_Click"/>
                        <Button x:Name="SnapshotButton" Content="Snapshot" Style="{StaticResource ModernButton}" Click="TakeSnapshot_Click"/>
                        <Button x:Name="AnalyzeButton" Content="Analyze" Style="{StaticResource ModernButton}" Click="OpenAnalysis_Click"/>
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Hidden compatibility controls: no visible top metric strip. -->
        <StackPanel Visibility="Collapsed">
            <TextBlock x:Name="AcquisitionTitle" Text="System"/>
            <GroupBox x:Name="ScanControlsGroup" Header="SCAN CONTROLS"/>
            <GroupBox x:Name="PluginsGroup" Header="PLUGINS"/>
            <GroupBox x:Name="DetectorStatusGroup" Header="DETECTOR STATUS"/>
            <GroupBox x:Name="FiltersGroup" Header="IMAGE FILTERS"/>

            <TextBlock x:Name="LinePositionLabel" Text="LINE POSITION"/>
            <TextBlock x:Name="PositionText" Text="Belt: 0px  Column: 0"/>
            <TextBlock x:Name="ObjectsLabel" Text="OBJECTS"/>
            <TextBlock x:Name="ObjectsText" Text="Objects: 0"/>
            <TextBlock x:Name="ConveyorLabel" Text="CONVEYOR"/>
            <TextBlock x:Name="SpeedText" Text="Speed: 1.0x"/>
            <TextBlock x:Name="DetectorArrayLabel" Text="DETECTORS"/>
            <TextBlock x:Name="DetectorsText" Text="400/400"/>
            <TextBlock x:Name="MaterialsLabel" Text="MATERIALS"/>
            <TextBlock x:Name="MaterialsText" Text="Materials: 0 types"/>

            <ProgressBar x:Name="DetectorHealthBar" Value="95" Maximum="100"/>
            <TextBlock x:Name="DetectorHealthText" Text="Health: 95%"/>
            <TextBlock x:Name="SystemInfoLabel" Text="SYSTEM"/>
            <TextBlock x:Name="FrameRateText" Text="FPS: 0"/>
            <TextBlock x:Name="MemoryText" Text="Memory: 0 MB"/>
            <TextBlock x:Name="ProcessingText" Text="Processing: Idle"/>
            <TextBlock x:Name="FilterCountText" Text="Active Filters: 0"/>

            <TextBlock x:Name="FilterPresetLabel" Text="Filter preset"/>
            <ComboBox x:Name="OperatorFilterComboBox" SelectionChanged="OperatorFilter_Changed"/>
            <Button x:Name="ApplyFiltersButton" Content="Apply Filters" Click="ApplyFilters_Click"/>
        </StackPanel>

        <StatusBar Grid.Row="2" Background="#0B1118" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="MainStatusText" Text="SEE INSADE - Ready for scanning" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="TimeText" Text="00:00:00" Foreground="{StaticResource MutedTextBrush}" Margin="10,0,0,0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
