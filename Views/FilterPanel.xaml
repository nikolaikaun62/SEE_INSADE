<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="SEE_INSADE.Views.FilterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="60" d:DesignWidth="800">
    <Border Background="#f8f9fa" Padding="15" BorderBrush="#dee2e6" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Filters:" VerticalAlignment="Center" 
                      Margin="0,0,15,0" FontWeight="SemiBold" FontSize="14"/>

            <!-- Status -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                <TextBlock Text="Status:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox ItemsSource="{Binding StatusOptions}" 
                         SelectedItem="{Binding SelectedStatus}"
                         Width="140" Padding="5,2"/>
            </StackPanel>

            <!-- Dates -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <DatePicker SelectedDate="{Binding StartDate}" 
                           Width="120" Padding="2"
                           ToolTip="Start date"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <DatePicker SelectedDate="{Binding EndDate}" 
                           Width="120" Padding="2"
                           ToolTip="End date"/>
            </StackPanel>

            <!-- Search -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        Width="200" Padding="8,4"
                        ToolTip="Search by detector name"
                        VerticalContentAlignment="Center"/>
            </StackPanel>

            <!-- Reset button -->
            <Button Content="Reset Filters" 
                   Command="{Binding ResetFiltersCommand}"
                   Background="#6c757d" Foreground="White"
                   Padding="12,6" BorderThickness="0"
                   Cursor="Hand"/>
        </StackPanel>
    </Border>
</UserControl>