<Window x:Class="NuctechImgViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuctech IMG Viewer"
        Width="1320"
        Height="820"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="LineBrush" Color="#D4DAE3"/>
        <SolidColorBrush x:Key="TextBrush" Color="#17202C"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#667085"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#007A78"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="FilterButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Nuctech IMG Viewer" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Native OIS/Nuctech IMG decode, material view, operator filters" Style="{StaticResource LabelStyle}" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Open IMG" Style="{StaticResource ButtonStyle}" Click="OpenImg_Click"/>
                <Button Content="Export PNG" Style="{StaticResource ButtonStyle}" Click="ExportPng_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                <WrapPanel x:Name="FilterButtonsPanel">
                    <Button Content="Enhanced" Tag="EnhancedColor" Style="{StaticResource FilterButtonStyle}" Click="FilterButton_Click"/>
                    <Button Content="High Penetration" Tag="HighPenetration" Style="{StaticResource FilterButtonStyle}" Click="FilterButton_Click"/>
                    <Button Content="Organic" Tag="OrganicFocus" Style="{StaticResource FilterButtonStyle}" Click="FilterButton_Click"/>
                    <Button Content="Inorganic" Tag="InorganicFocus" Style="{StaticResource FilterButtonStyle}" Click="FilterButton_Click"/>
                    <Button Content="Metal" Tag="MetalFocus" Style="{StaticResource FilterButtonStyle}" Click="FilterButton_Click"/>
                    <Button Content="Density" Tag="DensityMap" Style="{StaticResource FilterButtonStyle}" Click="FilterButton_Click"/>
                    <Button Content="Negative" Tag="Negative" Style="{StaticResource FilterButtonStyle}" Click="FilterButton_Click"/>
                    <Button Content="Edge" Tag="EdgeEmphasis" Style="{StaticResource FilterButtonStyle}" Click="FilterButton_Click"/>
                    <Button Content="Suspect" Tag="SuspectHighlight" Style="{StaticResource FilterButtonStyle}" Click="FilterButton_Click"/>
                </WrapPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Filter strength" Style="{StaticResource LabelStyle}"/>
                    <Slider x:Name="FilterStrengthSlider" Minimum="0.1" Maximum="3.0" Value="1.0" ValueChanged="FilterSettings_Changed"/>
                    <WrapPanel Margin="0,6,0,0">
                        <CheckBox x:Name="BrightnessCheck" Content="Brightness" Margin="0,0,12,0" Checked="FilterSettings_Changed" Unchecked="FilterSettings_Changed"/>
                        <CheckBox x:Name="ContrastCheck" Content="Contrast" Checked="FilterSettings_Changed" Unchecked="FilterSettings_Changed"/>
                    </WrapPanel>
                    <Slider x:Name="BrightnessSlider" Minimum="0.1" Maximum="3.0" Value="1.0" ValueChanged="FilterSettings_Changed"/>
                    <Slider x:Name="ContrastSlider" Minimum="0.1" Maximum="3.0" Value="1.0" ValueChanged="FilterSettings_Changed"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
            <Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FFFFFF">
                    <Image x:Name="PreviewImage" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality"/>
                </ScrollViewer>
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#EFFFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="10">
                    <StackPanel>
                        <TextBlock x:Name="FileText" Text="No file loaded" FontWeight="Bold"/>
                        <TextBlock x:Name="MetaText" Text="Open .img file" Style="{StaticResource LabelStyle}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <StatusBar Grid.Row="3" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,12,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
